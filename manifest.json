{
    "manifest_version": 3,
    "name": "QR Code Reader",
    "version": "1.1.1",
    "description": "Select an area on the screen to scan a QR code.",
    "permissions": ["activeTab", "scripting"],
    "default_locale": "en",
    "action": {
        "default_title": "Scan QR Code"
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "128": "icon.png"
    }
}
